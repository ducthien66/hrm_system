          "refId": "A"
        }
      ],
      "title": "Tần suất Request theo HTTP Status Code (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
