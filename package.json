{
  "name": "hrm-system",
  "version": "1.0.0",
  "description": "Enterprise Human Resource Management System (HRM)",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test:backend": "cd backend && npm run test",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "db:seed": "cd backend && npm run prisma:seed",
    "db:push": "cd backend && npm run prisma:push"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
