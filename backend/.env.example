PORT=5000
NODE_ENV=development
# Cơ sở dữ liệu: Dùng SQLite cho phát triển/kiểm thử cục bộ, hoặc PostgreSQL khi chạy Production/Docker
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hrm_db?schema=public"

JWT_SECRET="hrm_enterprise_jwt_secret_key_at_least_32_characters_long_2026"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="hrm_enterprise_refresh_token_secret_key_2026_super_secure"
REFRESH_TOKEN_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"
